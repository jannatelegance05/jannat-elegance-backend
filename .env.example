NODE_ENV=development
# Local-only port. Cloud providers normally inject PORT automatically.
BACKEND_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/jannat-elegance?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id
RESEND_API_KEY=re_replace_me
EMAIL_FROM=orders@your-verified-domain.example
CONTACT_EMAIL=jannatelegance05@gmail.com
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
# Delhivery One shipping (Settings → API Setup in the Delhivery One panel)
DELHIVERY_API_TOKEN=replace_me
# staging or production
DELHIVERY_ENV=staging
# Exact registered warehouse / pickup location name in Delhivery One
DELHIVERY_PICKUP_LOCATION=Jannat Elegance Warehouse
DELHIVERY_ORIGIN_PINCODE=110001
DELHIVERY_SELLER_NAME=Jannat Elegance
DELHIVERY_SELLER_ADDRESS=replace_with_warehouse_address
DELHIVERY_SELLER_GSTIN=
DELHIVERY_HSN_CODE=6204
# Surface or Express
DELHIVERY_SHIPPING_MODE=Surface
DELHIVERY_DEFAULT_WEIGHT_GRAMS=500
DELHIVERY_DEFAULT_LENGTH_CM=30
DELHIVERY_DEFAULT_WIDTH_CM=25
DELHIVERY_DEFAULT_HEIGHT_CM=5
# Shared secret for /api/webhooks/delhivery?token=...
DELHIVERY_WEBHOOK_TOKEN=replace_with_long_random_string
# Background tracking sync interval; 0 disables it
DELHIVERY_SYNC_INTERVAL_MINUTES=30
# Set false to allow checkout for pincodes Delhivery reports as unserviceable
DELHIVERY_BLOCK_UNSERVICEABLE=true
